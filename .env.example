APP_NAME=TechBizBoard

# DB — 비밀값. 실제 .env 에만 채운다(.env 는 .gitignore 로 제외).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=adtech_team
DB_USER=
DB_PASSWORD=

# 팀 환율 API
EXCHANGE_URL=https://lucy-dev.conbus.co.kr/api/exchange/

# API 사용량 조회 — 조직 Admin 키(있을 때만). 없으면 해당 공급자는 "미설정"으로 표시.
OPENAI_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY=

# SSO (Account Hub). secret 없음.
SSO_REQUIRE_LOGIN=1
SSO_PROVIDER_URL=https://account.innored.co.kr
SSO_CLIENT_ID=tbb
# redirect_uri/home_url 은 서버마다 호스트도 경로도 다르므로 각 서버 .env 에 그 서버 값을 넣는다.
# redirect_uri 는 Account Hub 에 등록된 문자열과 정확히 일치해야 한다.
#   개발: SSO_REDIRECT_URI=https://lucy-dev.conbus.co.kr/tech-bizboard/sso/  ·  SSO_HOME_URL=https://lucy-dev.conbus.co.kr/tech-bizboard/
#   운영: SSO_REDIRECT_URI=https://tbb.conbus.co.kr/sso/                     ·  SSO_HOME_URL=https://tbb.conbus.co.kr/
# ※ 운영 redirect_uri(https://tbb.conbus.co.kr/sso/)는 Account Hub 에 반드시 등록(화이트리스트)해 둬야 authorize 가 통과한다.
SSO_REDIRECT_URI=
SSO_HOME_URL=


#read-only
OPENAI_ADMIN_KEY=

# 영수증 AI 분석용 Claude 일반 API 키(서버사이드 전용). 없으면 기능만 비활성, 수기 입력은 정상.
CLAUDE_API_KEY=